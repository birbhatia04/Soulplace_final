# Leave VITE_FRAPPE_URL empty during local development so browser requests stay
# same-origin and use the Vite /api proxy.
VITE_FRAPPE_URL=
FRAPPE_PROXY_TARGET=http://soulplace.localhost:8000

# Set true only for local frontend testing. Demo mode makes no Frappe requests.
VITE_DEMO_MODE=false

# Google OAuth 2.0 Web client ID used only when a doctor creates a Meet room.
# Enable the Google Meet REST API and add this app's origin to the client's
# Authorized JavaScript origins. Access tokens remain in browser memory.
VITE_GOOGLE_CLIENT_ID=

# Shown on consent records created by the web application.
VITE_CONSENT_VERSION=1.0

# Leave payments disabled until a reviewed gateway and server-owned checkout
# flow are configured. The frontend never collects card data itself.
VITE_PAYMENTS_ENABLED=false

# Optional same-origin or explicitly CSP-allowlisted client error collector.
VITE_ERROR_REPORTING_URL=
VITE_APP_RELEASE=
